<Window x:Class="SFTLauncher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:SFTLauncher"
        Title="SFT Launcher" 
        Height="750" Width="1200"
        MinHeight="600" MinWidth="900"
        MaxWidth="1920"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResizeWithGrip"
        AllowsTransparency="True"
        Background="Transparent"
        WindowStyle="None"
        MouseDown="Window_MouseDown">
    
    <!-- 窗口背景 -->
    <Border Background="{StaticResource BackgroundBrush}" 
            CornerRadius="12"
            BorderThickness="1"
            BorderBrush="{StaticResource BorderBrush}"
            Effect="{StaticResource ShadowMedium}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="40"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            
            <!-- 顶部标题栏 -->
            <Border Grid.Row="0" Background="{StaticResource SidebarBrush}"
                    BorderThickness="0,0,0,1" BorderBrush="{StaticResource BorderBrush}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    
                    <!-- Logo -->
                    <StackPanel Orientation="Horizontal" Margin="16,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="SFT" FontSize="14" FontWeight="700" 
                                   Foreground="{StaticResource AccentDarkBrush}" Margin="0,0,8,0"/>
                        <TextBlock Text="Launcher" FontSize="14" FontWeight="400"
                                   Foreground="{StaticResource TextSecondaryBrush}"/>
                    </StackPanel>
                    
                    <!-- 窗口控制按钮 -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- 最小化 -->
                        <Button Width="46" Height="32" Background="Transparent" BorderThickness="0"
                                Cursor="Hand" Click="Minimize_Click">
                            <TextBlock Text="—" FontSize="14" Foreground="{StaticResource TextMutedBrush}" 
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}" 
                                                        Width="{TemplateBinding Width}" Height="{TemplateBinding Height}">
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#E5E7EB"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        
                        <!-- 最大化/还原 -->
                        <Button x:Name="BtnMaximize" Width="46" Height="32" Background="Transparent" BorderThickness="0"
                                Cursor="Hand" Click="Maximize_Click">
                            <TextBlock x:Name="MaximizeIcon" Text="□" FontSize="12" 
                                       Foreground="{StaticResource TextMutedBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}" 
                                                        Width="{TemplateBinding Width}" Height="{TemplateBinding Height}">
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#E5E7EB"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        
                        <!-- 关闭 -->
                        <Button Width="46" Height="32" Background="Transparent" BorderThickness="0"
                                Cursor="Hand" Click="CloseButton_Click">
                            <TextBlock Text="✕" FontSize="12" Foreground="{StaticResource TextMutedBrush}" 
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}" 
                                                        Width="{TemplateBinding Width}" Height="{TemplateBinding Height}">
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#F87171"/>
                                            <Setter Property="Foreground" Value="White"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>
            
            <!-- 主内容区域 -->
            <Grid Grid.Row="1" Margin="0,0,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="60"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                
                <!-- 侧边栏（只图标） -->
                <Border Grid.Column="0" 
                        Background="{StaticResource SidebarBrush}"
                        BorderThickness="0,0,1,0"
                        BorderBrush="{StaticResource BorderBrush}">
                    <StackPanel Margin="0,12,0,0">
                        
                        <!-- 导航按钮 -->
                        <Button x:Name="BtnHome" Style="{StaticResource NavItemStyle}" 
                                Height="48" Tag="home" Click="NavButton_Click"
                                ToolTip="主页">
                            <TextBlock Text="🏠" FontSize="20"/>
                        </Button>
                        
                        <Button x:Name="BtnInstances" Style="{StaticResource NavItemStyle}" 
                                Height="48" Tag="instances" Click="NavButton_Click"
                                ToolTip="实例库">
                            <TextBlock Text="📦" FontSize="20"/>
                        </Button>
                        
                        <Button x:Name="BtnDownloads" Style="{StaticResource NavItemStyle}" 
                                Height="48" Tag="downloads" Click="NavButton_Click"
                                ToolTip="版本下载">
                            <TextBlock Text="⬇️" FontSize="20"/>
                        </Button>
                        
                        <Button x:Name="BtnMods" Style="{StaticResource NavItemStyle}" 
                                Height="48" Tag="mods" Click="NavButton_Click"
                                ToolTip="资源库">
                            <TextBlock Text="📚" FontSize="20"/>
                        </Button>
                        
                        <Button x:Name="BtnAI" Style="{StaticResource NavItemStyle}" 
                                Height="48" Tag="ai" Click="NavButton_Click"
                                ToolTip="AI 助手">
                            <TextBlock Text="🤖" FontSize="20"/>
                        </Button>
                        
                        <Button x:Name="BtnSettings" Style="{StaticResource NavItemStyle}" 
                                Height="48" Tag="settings" Click="NavButton_Click"
                                ToolTip="设置">
                            <TextBlock Text="⚙️" FontSize="20"/>
                        </Button>
                        
                    </StackPanel>
                </Border>
                
                <!-- 内容区 -->
                <Grid Grid.Column="1" Margin="20,16,20,20">
                    <Frame x:Name="ContentFrame" NavigationUIVisibility="Hidden"/>
                </Grid>
                

            </Grid>
        </Grid>
    </Border>
</Window>
