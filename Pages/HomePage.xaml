<Page x:Class="SFTLauncher.Pages.HomePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="0,0,0,24">
            
            <!-- 欢迎区域 -->
            <Border Style="{StaticResource CardStyle}" Padding="32,24">
                <StackPanel>
                    <TextBlock Text="欢迎回来，玩家！" Style="{StaticResource LabelTitle}" Margin="0,0,0,8"/>
                    <TextBlock Text="今天想玩点什么？" Style="{StaticResource LabelSecondary}"/>
                </StackPanel>
            </Border>
            
            <!-- 快速操作 - 使用垂直布局，增加间距 -->
            <StackPanel Margin="0,40,0,0">
                
                <!-- 左侧：实例列表 -->
                <Border Style="{StaticResource CardStyle}" Padding="24" Margin="0,0,0,24">
                    <StackPanel>
                        <Grid Margin="0,0,0,16">
                            <TextBlock Text="我的实例" Style="{StaticResource LabelHeading}"/>
                            <Button Style="{StaticResource AccentButton}" HorizontalAlignment="Right"
                                    Height="32" Width="110" Content="+ 新建实例" Click="NewInstance_Click"/>
                        </Grid>

                        <!-- 已安装实例列表 -->
                        <ItemsControl x:Name="InstanceList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#F9FAFB" CornerRadius="12" Padding="16" Margin="0,0,0,10">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding DisplayName}" Style="{StaticResource LabelHeading}"/>
                                                <TextBlock Text="{Binding Subtitle}" Style="{StaticResource LabelMuted}" Margin="0,4,0,0"/>
                                            </StackPanel>
                                            <Button Grid.Column="1" Style="{StaticResource AccentButton}"
                                                    Height="36" Width="100" Content="▶ 启动"
                                                    Tag="{Binding VersionId}"
                                                    Click="StartInstance_Click"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- 空状态：没有扫描到版本时才显示 -->
                        <StackPanel x:Name="EmptyState" HorizontalAlignment="Center" Visibility="Collapsed">
                            <TextBlock Text="📦" FontSize="48" HorizontalAlignment="Center" Margin="0,0,0,16"/>
                            <TextBlock Text="还没有实例" Style="{StaticResource LabelHeading}" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                            <TextBlock Text="点击「+ 新建实例」下载一个版本" Style="{StaticResource LabelSecondary}" HorizontalAlignment="Center"/>
                            <TextBlock Text="来开始你的冒险！" Style="{StaticResource LabelSecondary}" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
                
                <!-- 右侧：统计信息 -->
                <Border Style="{StaticResource CardStyle}" Padding="24">
                    <StackPanel>
                        <TextBlock Text="统计" Style="{StaticResource LabelHeading}" Margin="0,0,0,20"/>

                        <Border Background="#F9FAFB" CornerRadius="12" Padding="16" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock x:Name="VersionCountText" Text="0" Style="{StaticResource LabelTitle}" Foreground="{StaticResource AccentBrush}"/>
                                <TextBlock Text="已安装版本" Style="{StaticResource LabelMuted}"/>
                            </StackPanel>
                        </Border>

                        <Border Background="#F9FAFB" CornerRadius="12" Padding="16" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock x:Name="JavaStatusText" Text="检测中..." Style="{StaticResource LabelTitle}" Foreground="{StaticResource SuccessBrush}"/>
                                <TextBlock x:Name="JavaStatusDetail" Text="Java 运行时" Style="{StaticResource LabelMuted}"/>
                            </StackPanel>
                        </Border>
                        
                        <Border Background="#F9FAFB" CornerRadius="12" Padding="16">
                            <StackPanel>
                                <TextBlock Text="SFT Launcher v3" Style="{StaticResource LabelTitle}" Foreground="{StaticResource TextSecondaryBrush}"/>
                                <TextBlock x:Name="DirectoryText" Text="" Style="{StaticResource LabelMuted}" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>
                
            </StackPanel>
            
        </StackPanel>
    </ScrollViewer>
</Page>
