<Page x:Class="SFTLauncher.Pages.ModsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="0,0,0,24">
            
            <!-- Search bar -->
            <Grid Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                
                <TextBox x:Name="SearchBox"
                         Background="#F9FAFB" Foreground="#111827"
                         BorderThickness="1" BorderBrush="#E5E7EB"
                         Padding="16,14" FontSize="15"
                         Height="50" Margin="0,0,12,0"
                         Text="输入模组名称搜索..."/>
                
                <Button Grid.Column="1" Style="{StaticResource PrimaryButton}" 
                        Height="50" Width="90" Margin="12,0,0,0"
                        Content="搜索" Click="SearchButton_Click"/>
            </Grid>
            
            <!-- 状态提示 -->
            <TextBlock x:Name="StatusText" 
                       Foreground="#9CA3AF" FontSize="13" 
                       Margin="0,0,0,12"
                       Text="输入关键词搜索 Modrinth 资源库"/>
            
            <!-- 模组列表 -->
            <StackPanel x:Name="ModsList"/>
            
        </StackPanel>
    </ScrollViewer>
</Page>
