<Page x:Class="SFTLauncher.Pages.SettingsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="0,0,0,24">
            
            <!-- 标题 -->
            <TextBlock Text="设置" Foreground="#111827" FontSize="24" FontWeight="700" Margin="0,0,0,24"/>
            
            <!-- 账户设置 -->
            <Border Background="#FFFFFF" CornerRadius="12" BorderThickness="1" BorderBrush="#E5E7EB" Padding="20" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="账户设置" Foreground="#111827" FontSize="16" FontWeight="600" Margin="0,0,0,16"/>
                    
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="140"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="用户名:" Foreground="#4B5563" FontSize="13" VerticalAlignment="Center"/>
                        <TextBox Grid.Column="1" 
                                 Background="#F9FAFB" Foreground="#111827" BorderThickness="1" BorderBrush="#E5E7EB"
                                 Padding="16,14" FontSize="15" Height="50" Margin="12,0,0,0"
                                 x:Name="UsernameBox"/>
                    </Grid>
                    
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="140"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="UUID:" Foreground="#4B5563" FontSize="13" VerticalAlignment="Center"/>
                        <TextBox Grid.Column="1" 
                                 Background="#F9FAFB" Foreground="#111827" BorderThickness="1" BorderBrush="#E5E7EB"
                                 Padding="16,14" FontSize="15" Height="50" Margin="12,0,0,0"
                                 x:Name="UuidBox"/>
                    </Grid>
                </StackPanel>
            </Border>
            
            <!-- 游戏路径 -->
            <Border Background="#FFFFFF" CornerRadius="12" BorderThickness="1" BorderBrush="#E5E7EB" Padding="20" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="游戏路径" Foreground="#111827" FontSize="16" FontWeight="600" Margin="0,0,0,16"/>
                    
                    <Grid Margin="0,0,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="140"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="80"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Minecraft 目录:" Foreground="#4B5563" FontSize="13" VerticalAlignment="Center"/>
                        <TextBox Grid.Column="1" 
                                 Background="#F9FAFB" Foreground="#111827" BorderThickness="1" BorderBrush="#E5E7EB"
                                 Padding="16,14" FontSize="15" Height="50" Margin="12,0,0,0"
                                 x:Name="McPathBox"/>
                        <Button Grid.Column="2" 
                                Background="#F9FAFB" Foreground="#6B7280" BorderThickness="1" BorderBrush="#E5E7EB"
                                Height="50" Margin="12,0,0,0" Cursor="Hand" Padding="16,0" FontSize="15"
                                Content="浏览" Click="BrowseMcPath_Click"/>
                    </Grid>
                    
                    <TextBlock x:Name="McPathStatus" Text="" Foreground="#9CA3AF" FontSize="12"
                               Margin="152,0,0,4" TextWrapping="Wrap"/>
                    <Button Content="自动检测已安装的 Minecraft 目录" Height="30" Padding="12,0" Margin="152,0,0,12"
                            HorizontalAlignment="Left" Cursor="Hand" FontSize="12"
                            Background="#F9FAFB" Foreground="#6B7280"
                            BorderThickness="1" BorderBrush="#E5E7EB"
                            Click="DetectMcPath_Click"/>

                    <Grid Margin="0,0,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="140"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="80"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Java 路径:" Foreground="#4B5563" FontSize="13" VerticalAlignment="Center"/>
                        <TextBox Grid.Column="1"
                                 Background="#F9FAFB" Foreground="#111827" BorderThickness="1" BorderBrush="#E5E7EB"
                                 Padding="16,14" FontSize="15" Height="50" Margin="12,0,0,0"
                                 x:Name="JavaPathBox"/>
                        <Button Grid.Column="2"
                                Background="#F9FAFB" Foreground="#6B7280" BorderThickness="1" BorderBrush="#E5E7EB"
                                Height="50" Margin="12,0,0,0" Cursor="Hand" Padding="16,0" FontSize="15"
                                Content="浏览" Click="BrowseJavaPath_Click"/>
                    </Grid>

                    <TextBlock x:Name="JavaHintText" Text="" Foreground="#9CA3AF" FontSize="12"
                               Margin="152,0,0,4" TextWrapping="Wrap"/>
                    <Button Content="检测本机 Java 并自动填入" Height="30" Padding="12,0" Margin="152,0,0,12"
                            HorizontalAlignment="Left" Cursor="Hand" FontSize="12"
                            Background="#F9FAFB" Foreground="#6B7280"
                            BorderThickness="1" BorderBrush="#E5E7EB"
                            Click="DetectJava_Click"/>
                    
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="140"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="最大内存 (GB):" Foreground="#4B5563" FontSize="13" VerticalAlignment="Center"/>
                        <Slider Grid.Column="1" x:Name="MemorySlider" Minimum="2" Maximum="32" Value="4" 
                                TickFrequency="2" IsSnapToTickEnabled="True" Margin="12,14,0,0"
                                ValueChanged="MemorySlider_ValueChanged"/>
                        <TextBlock Grid.Column="1" x:Name="MemoryText" Text="4 GB" HorizontalAlignment="Right" VerticalAlignment="Center"
                                   Foreground="#9CA3AF" FontSize="13"/>
                    </Grid>
                </StackPanel>
            </Border>
            
            <!-- 代理设置 -->
            <Border Background="#FFFFFF" CornerRadius="12" BorderThickness="1" BorderBrush="#E5E7EB" Padding="20">
                <StackPanel>
                    <TextBlock Text="代理设置" Foreground="#111827" FontSize="16" FontWeight="600" Margin="0,0,0,16"/>
                    
                    <CheckBox x:Name="ProxyCheck" Content="启用代理" Margin="0,0,0,12"
                              Foreground="#111827" FontSize="14"/>
                    
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="140"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="代理地址:" Foreground="#4B5563" FontSize="13" VerticalAlignment="Center"/>
                        <TextBox Grid.Column="1"
                                 Background="#F9FAFB" Foreground="#111827" BorderThickness="1" BorderBrush="#E5E7EB"
                                 Padding="16,14" FontSize="15" Height="50" Margin="12,0,0,0"
                                 x:Name="ProxyAddressBox"/>
                    </Grid>
                </StackPanel>
            </Border>
            
            <!-- 保存按钮 -->
            <Button Background="#A78BFA" Foreground="#FFFFFF" BorderThickness="0"
                    Height="50" Width="140" Margin="0,24,0,0" Padding="24,0" FontSize="15" FontWeight="600" Cursor="Hand"
                    HorizontalAlignment="Right" Content="保存设置" Click="SaveSettings_Click"/>
            
        </StackPanel>
    </ScrollViewer>
</Page>
