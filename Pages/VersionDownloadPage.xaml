<Page x:Class="SFTLauncher.Pages.VersionDownloadPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="0,0,0,24">
            
            <!-- 标题栏 -->
            <TextBlock Text="下载 Minecraft" Foreground="#111827" FontSize="24" FontWeight="700" Margin="0,0,0,20"/>
            
            <!-- 版本选择 -->
            <Border Background="#FFFFFF" CornerRadius="12" BorderThickness="1" BorderBrush="#E5E7EB" Padding="20" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="选择版本" Foreground="#111827" FontSize="15" FontWeight="600" Margin="0,0,0,12"/>
                    
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="90"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="40"/>
                        </Grid.ColumnDefinitions>
                        
                        <TextBlock Grid.Column="0" Text="版本:" Foreground="#4B5563" FontSize="13" VerticalAlignment="Center"/>
                        <ComboBox Grid.Column="1" x:Name="VersionComboBox"
                                  Background="#F9FAFB" Foreground="#111827" BorderThickness="1" BorderBrush="#E5E7EB"
                                  Height="44" Margin="8,0,8,0" FontSize="14"
                                  VerticalContentAlignment="Center"/>
                        <TextBlock Grid.Column="2" x:Name="VersionStatus" Foreground="#34D399" FontSize="16"
                                   VerticalAlignment="Center" HorizontalAlignment="Center"/>
                    </Grid>
                    <StackPanel Orientation="Horizontal" Margin="98,12,0,0">
                        <TextBlock Text="下载源:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <ComboBox x:Name="DownloadSourceComboBox" Width="160" DisplayMemberPath="Name"/>
                        <TextBlock Text="并发:" VerticalAlignment="Center" Margin="16,0,8,0"/>
                        <ComboBox x:Name="DownloadConcurrencyComboBox" Width="80"/>
                        <TextBlock Text="慢时可切换官方/BMCL；失败自动尝试另一源" VerticalAlignment="Center" Margin="12,0,0,0"/>
                    </StackPanel>
                </StackPanel>
            </Border>
            
            <!-- 安装路径 -->
            <Border Background="#FFFFFF" CornerRadius="12" BorderThickness="1" BorderBrush="#E5E7EB" Padding="20" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="安装位置" Foreground="#111827" FontSize="15" FontWeight="600" Margin="0,0,0,12"/>
                    
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="90"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="70"/>
                            <ColumnDefinition Width="110"/>
                        </Grid.ColumnDefinitions>
                        
                        <TextBlock Grid.Column="0" Text="目录:" Foreground="#4B5563" FontSize="13" VerticalAlignment="Center"/>
                        <TextBox Grid.Column="1" x:Name="InstallPathBox"
                                 Background="#F9FAFB" Foreground="#111827" BorderThickness="1" BorderBrush="#E5E7EB"
                                 Height="44" Margin="8,0,8,0" FontSize="14"
                                 VerticalContentAlignment="Center"/>
                        <Button Grid.Column="2" Content="浏览目录"
                                Background="#F9FAFB" Foreground="#6B7280" BorderThickness="1" BorderBrush="#E5E7EB"
                                Height="44" Cursor="Hand" Padding="8,0" FontSize="13"
                                Click="BrowsePath_Click"/>
                        <Button Grid.Column="3" Content="自动检测"
                                Background="#F9FAFB" Foreground="#6B7280" BorderThickness="1" BorderBrush="#E5E7EB"
                                Height="44" Margin="8,0,0,0" Cursor="Hand" Padding="8,0" FontSize="13"
                                Click="DetectPath_Click"/>
                    </Grid>
                    
                    <TextBlock x:Name="PathStatus" Foreground="#9CA3AF" FontSize="12" Margin="98,6,0,0" Text="默认安装位置"/>
                </StackPanel>
            </Border>
            
            <!-- 下载进度 -->
            <Border Background="#FFFFFF" CornerRadius="12" BorderThickness="1" BorderBrush="#E5E7EB" Padding="20" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="下载进度" Foreground="#111827" FontSize="15" FontWeight="600" Margin="0,0,0,12"/>
                    
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="50"/>
                        </Grid.ColumnDefinitions>
                        
                        <ProgressBar x:Name="ProgressBar" Height="6" Margin="0,0,8,0"
                                     Value="0" Maximum="100" Foreground="#A78BFA" Background="#E5E7EB"
                                     VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1" x:Name="ProgressText" Text="0%" Foreground="#4B5563"
                                   FontSize="12" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                    </Grid>
                    
                    <TextBlock x:Name="StatusText" Foreground="#4B5563" FontSize="13" Margin="0,10,0,0" Text="准备就绪"/>
                </StackPanel>
            </Border>
            
            <!-- 操作按钮 -->
            <Grid Margin="0,4,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                
                <TextBlock Grid.Column="0" x:Name="InfoText" Foreground="#9CA3AF" FontSize="12" VerticalAlignment="Center"/>
                
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button x:Name="CancelButton" Style="{StaticResource GhostButton}"
                            Height="44" Padding="20,0" Content="停止" Click="CancelButton_Click" Margin="0,0,12,0"
                            Visibility="Collapsed"/>
                    <Button x:Name="DownloadButton" Background="#A78BFA" Foreground="#FFFFFF" BorderThickness="0"
                            Height="44" Padding="28,0" FontSize="14" FontWeight="600" Cursor="Hand"
                            Content="⬇ 开始下载" Click="DownloadButton_Click"/>
                </StackPanel>
            </Grid>
            
            <!-- 下载历史 -->
            <Border Background="#FFFFFF" CornerRadius="12" BorderThickness="1" BorderBrush="#E5E7EB" Padding="20" Margin="0,20,0,0"
                    Visibility="{Binding ElementName=DownloadHistoryPanel, Path=Visibility}">
                <StackPanel>
                    <TextBlock Text="下载历史" Foreground="#111827" FontSize="15" FontWeight="600" Margin="0,0,0,12"/>
                    <StackPanel x:Name="DownloadHistoryPanel"/>
                </StackPanel>
            </Border>
            
        </StackPanel>
    </ScrollViewer>
</Page>
